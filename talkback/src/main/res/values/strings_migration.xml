<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Title of the notification and dialog that offer to install newTalk under its new app ID. [CHAR LIMIT=NONE] -->
    <string name="update_move_title">newTalk is moving to a new app</string>
    <!-- Text of the notification that offers to install newTalk under its new app ID. [CHAR LIMIT=NONE] -->
    <string name="update_move_notification_text">Install the new newTalk; your settings come with it. Tap to install.</string>
    <!-- Message of the dialog that offers to install newTalk under its new app ID. [CHAR LIMIT=NONE] -->
    <string name="update_move_dialog_message">newTalk is moving to a new app ID, so it can install on more phones. Install the new newTalk; your settings come with it. Then turn it on, and this one turns itself off.</string>
    <!-- Announced before the install prompt for newTalk under its new app ID. [CHAR LIMIT=NONE] -->
    <string name="update_move_installing">newTalk is moving to a new app ID. Install the new newTalk; your settings come with it.</string>
    <!-- Announced when the accessibility settings open after the new newTalk is installed. [CHAR LIMIT=NONE] -->
    <string name="update_move_turn_on">Turn on the new newTalk, then the old one turns itself off.</string>
    <!-- Shown when the downloaded update is not a newTalk build that can be installed. [CHAR LIMIT=NONE] -->
    <string name="update_wrong_package">The download is not a newTalk update, so it was not installed</string>
    <!-- Title of the notification that the new newTalk shows once it took over from the old one. [CHAR LIMIT=NONE] -->
    <string name="migration_moved_title">newTalk moved to a new app</string>
    <!-- Text of the notification that offers to uninstall the old newTalk. [CHAR LIMIT=NONE] -->
    <string name="migration_moved_text">Tap to remove the old one.</string>
</resources>
